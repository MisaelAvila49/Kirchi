* Inversor de ganancia 10 con LM324 a GBW/10, para comparar su respuesta en frecuencia
.include modelos.lib
V1 1 0 DC 15
V2 2 0 DC -15
VIN 3 0 SIN(0 0.03 120000)
RI 3 4 1k
RF 4 5 10k
RL 5 0 10k
XU1 0 4 5 1 2 AMPOP a0=100000 gbw=1.2e6 sr=500000 rin=1e7 rout=50 ilim=0.04 dhi=1.5 dlo=0.005 rq=42900
.options reltol=1e-4 abstol=1e-12 vntol=1e-7
.control
set wr_singlescale
set wr_vecnames
option numdgt=7
tran 2.083e-08 2.5e-05 0 1.042e-08 uic
wrdata salida.txt v(5)
.endc
.end
