* Seguidor con LM324 y escalon de 5 V: velocidad de subida
.include modelos.lib
V1 1 0 DC 15
V2 2 0 DC -15
VIN 3 0 PULSE(0 5 0 1p 1p 2.5e-05 5e-05)
RL 4 0 10k
XU1 3 4 4 1 2 AMPOP a0=100000 gbw=1.2e6 sr=500000 rin=1e7 rout=50 ilim=0.04 dhi=1.5 dlo=0.005 rq=42900
.options reltol=1e-4 abstol=1e-12 vntol=1e-7
.control
set wr_singlescale
set wr_vecnames
option numdgt=7
tran 2e-08 0.0001 0 1e-08 uic
wrdata salida.txt v(4)
.endc
.end
