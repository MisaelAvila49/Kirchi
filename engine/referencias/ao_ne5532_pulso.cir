* Seguidor con NE5532 y escalon de 5 V: velocidad de subida
.include modelos.lib
V1 1 0 DC 15
V2 2 0 DC -15
VIN 3 0 PULSE(0 5 0 1p 1p 5e-06 1e-05)
RL 4 0 10k
XU1 3 4 4 1 2 AMPOP a0=100000 gbw=1.2e7 sr=5e6 rin=300000 rout=0.3 ilim=0.038 dhi=2 dlo=2 rq=10000
.options reltol=1e-4 abstol=1e-12 vntol=1e-7
.control
set wr_singlescale
set wr_vecnames
option numdgt=7
tran 4e-09 2e-05 0 2e-09 uic
wrdata salida.txt v(4)
.endc
.end
