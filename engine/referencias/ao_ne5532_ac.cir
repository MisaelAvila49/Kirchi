* Inversor de ganancia 10 con NE5532 a GBW/10, para comparar su respuesta en frecuencia
.include modelos.lib
V1 1 0 DC 15
V2 2 0 DC -15
VIN 3 0 SIN(0 0.05 1.2e+06)
RI 3 4 1k
RF 4 5 10k
RL 5 0 10k
XU1 0 4 5 1 2 AMPOP a0=100000 gbw=1.2e7 sr=5e6 rin=300000 rout=0.3 ilim=0.038 dhi=2 dlo=2 rq=10000
.options reltol=1e-4 abstol=1e-12 vntol=1e-7
.control
set wr_singlescale
set wr_vecnames
option numdgt=7
tran 2.083e-09 2.5e-06 0 1.042e-09 uic
wrdata salida.txt v(5)
.endc
.end
