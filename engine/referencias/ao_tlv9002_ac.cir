* Inversor de ganancia 10 con TLV9002 a GBW/10, para comparar su respuesta en frecuencia
.include modelos.lib
V1 1 0 DC 2.5
V2 2 0 DC -2.5
VIN 3 0 SIN(0 0.03 100000)
RI 3 4 1k
RF 4 5 10k
RL 5 0 10k
XU1 0 4 5 1 2 AMPOP a0=710000 gbw=1e6 sr=2e6 rin=1e+12 rout=1200 ilim=0.055 dhi=0.02 dlo=0.02 rq=91700
.options reltol=1e-4 abstol=1e-12 vntol=1e-7
.control
set wr_singlescale
set wr_vecnames
option numdgt=7
tran 2.5e-08 3e-05 0 1.25e-08 uic
wrdata salida.txt v(5)
.endc
.end
