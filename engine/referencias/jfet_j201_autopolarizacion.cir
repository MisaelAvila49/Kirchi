* Autopolarizacion de un JFET J201 de canal N con resistencia en la fuente
.model JJ201 NJF(VTO=-0.67082 BETA=0.000993808 LAMBDA=0 IS=1e-14 N=1 PB=1 CGS=3.2e-12 CGD=5.2e-12 RD=0 RS=0)
V1 1 0 DC 15
RG 2 0 1Meg
RS 3 0 2.2k
RD 1 4 10k
J1 4 2 3 JJ201
.options reltol=1e-4 abstol=1e-12 vntol=1e-7
.control
set wr_singlescale
set wr_vecnames
option numdgt=7
op
wrdata salida.txt v(3) v(4) i(v1)
.endc
.end
