* Inversor de ganancia 10 con OP07 a GBW/10, para comparar su respuesta en frecuencia
.include modelos.lib
V1 1 0 DC 15
V2 2 0 DC -15
VIN 3 0 SIN(0 0.05 60000)
RI 3 4 1k
RF 4 5 10k
RL 5 0 10k
XU1 0 4 5 1 2 AMPOP a0=400000 gbw=600000 sr=300000 rin=3.3e7 rout=60 ilim=0.025 dhi=2.2 dlo=2.2 rq=11250
.options reltol=1e-4 abstol=1e-12 vntol=1e-7
.control
set wr_singlescale
set wr_vecnames
option numdgt=7
tran 4.167e-08 5e-05 0 2.083e-08 uic
wrdata salida.txt v(5)
.endc
.end
