{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "types": ["node", "vite/client"],
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/compartido/**/*", "electron.vite.config.ts", "vitest.config.ts", "vitest.rendimiento.config.ts", "playwright.config.ts", "e2e/**/*"]
}
